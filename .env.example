# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database Configuration
# For development (SQLite)
DATABASE_URL=sqlite:///hotel_furniture.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost/hotel_furniture_prod

# Email Configuration (Optional - for password reset, etc.)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@sdhotelfurniture.com

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Admin Configuration
ADMIN_EMAIL=admin@sdhotelfurniture.com